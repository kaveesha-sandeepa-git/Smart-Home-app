<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/device_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Status chip — top right -->
        <TextView
            android:id="@+id/device_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="ON"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/status_on"
            android:background="@drawable/status_chip_on_bg"
            android:letterSpacing="0.03" />

        <!-- Icon badge -->
        <ImageView
            android:id="@+id/device_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_below="@id/device_status"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:background="@drawable/icon_badge_light_bg"
            android:scaleType="centerInside"
            android:contentDescription="Device type icon"
            android:src="@drawable/ic_light" />

        <!-- Device name -->
        <TextView
            android:id="@+id/device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/device_icon"
            android:layout_marginTop="6dp"
            android:text="Device Name"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingEnd="40dp" />

        <!-- Device type label -->
        <TextView
            android:id="@+id/device_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/device_name"
            android:layout_marginTop="2dp"
            android:text="LIGHT"
            android:textSize="10sp"
            android:textColor="@color/ink_soft" />

        <!-- Divider -->
        <View
            android:id="@+id/card_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/device_type"
            android:layout_marginTop="8dp"
            android:background="@color/line" />

        <!-- Power label + toggle switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/card_divider"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="POWER"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/ink_soft"
                android:letterSpacing="0.04" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/btn_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
